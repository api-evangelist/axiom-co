          "name": "Run an APL query",
          "request": {
            "name": "Run an APL query",
            "description": {
              "content": "Run an Axiom Processing Language (APL) query across one or more datasets. The dataset(s) are named inside the APL statement itself.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "datasets",
                "_apl"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
